# LOCAL SQLite server settings (server.js only)
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-40-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters

# NETLIFY production variables are configured in the Netlify dashboard:
# DATABASE_URL=your-Neon-pooled-PostgreSQL-connection-string
# ADMIN_EMAIL=centre-admin@example.com
# ADMIN_PASSWORD=your-unique-password-at-least-14-characters
